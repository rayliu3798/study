{
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{
      "type": "command",
      "command": "python3 \"${PLUGIN_ROOT}/scripts/learn.py\" hook",
      "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/run.ps1\" hook",
      "timeout": 10
    }]}],
    "Stop": [{"hooks": [{
      "type": "command",
      "command": "python3 \"${PLUGIN_ROOT}/scripts/learn.py\" hook",
      "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/run.ps1\" hook",
      "timeout": 10
    }]}],
    "SessionStart": [{"hooks": [{
      "type": "command",
      "command": "python3 \"${PLUGIN_ROOT}/scripts/learn.py\" hook",
      "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/run.ps1\" hook",
      "timeout": 10
    }]}],
    "SessionEnd": [{"hooks": [{
      "type": "command",
      "command": "python3 \"${PLUGIN_ROOT}/scripts/learn.py\" hook",
      "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/run.ps1\" hook",
      "timeout": 3
    }]}]
  }
}
